#!/bin/sh
# Looks up where IP addresses are and flags any that aren't yours.
#   bin/ipcheck                  show your own IP right now
#   bin/ipcheck 73.12.44.201 ... look up these IPs
#   bin/ipcheck < activity.txt   pull every IP out of pasted sign-in activity
#   bin/ipcheck --trust 1.2.3.4  save an IP as yours
TRUSTED="${HOME}/.letsgetitdone-my-ips"
touch "$TRUSTED"

lookup() {
  curl -s --max-time 8 "https://ipwho.is/$1" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if not d.get("success"):
    print("lookup failed:", d.get("message", "unknown")); sys.exit()
c = d.get("connection") or {}
where = ", ".join(x for x in (d.get("city"), d.get("region"), d.get("country")) if x)
isp = c.get("isp") or c.get("org") or "unknown provider"
print("%s | %s | map: https://www.openstreetmap.org/?mlat=%s&mlon=%s&zoom=10" % (where, isp, d["latitude"], d["longitude"]))
' 2>/dev/null || echo "no connection"
}

if [ "$1" = "--trust" ]; then
  shift
  for ip in "$@"; do echo "$ip" >> "$TRUSTED"; echo "Saved $ip as yours."; done
  exit 0
fi

if [ $# -eq 0 ] && [ -t 0 ]; then
  ip=$(curl -s --max-time 5 https://ipwho.is/ | python3 -c 'import json,sys; print(json.load(sys.stdin)["ip"])' 2>/dev/null)
  [ -z "$ip" ] && { echo "Could not reach the network."; exit 1; }
  echo "Your IP right now: $ip"
  echo "  $(lookup "$ip")"
  grep -qxF "$ip" "$TRUSTED" || echo "  Not saved yet. Run: bin/ipcheck --trust $ip"
  exit 0
fi

if [ $# -gt 0 ]; then ips=$(printf '%s\n' "$@")
else ips=$(grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | grep -vE '^(10\.|127\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)' | sort -u)
fi

bad=0
for ip in $ips; do
  if grep -qxF "$ip" "$TRUSTED"; then tag="YOURS    "; else tag="NOT YOURS"; bad=$((bad + 1)); fi
  echo "$tag $ip  $(lookup "$ip")"
done
echo ""
echo "$bad IP(s) not yours. Sign out all other devices on that account and change the password."
